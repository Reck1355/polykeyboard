*.iml
.gradle/
.kotlin/
.idea/
build/
local.properties
.DS_Store
.cxx/
captures/
*.apk
*.aab
*.hprof
__pycache__/
*.pyc

# Downloaded ASR models — never commit these
/models/
*.bin
*.gguf
*.ggml
*.pte
third_party/executorch/*.aar

# ...but the lexicon and the bigram model are small generated assets the build depends on, and
# there is no way to rebuild them at install time, so they ship.
!engine/src/main/assets/lexicon_en.bin
!engine/src/main/assets/bigrams_en.bin
!engine/src/main/assets/trigrams_en.bin
!core/src/main/assets/emoji.bin

# Every language with a board ships the same three assets, and the same reason applies. The
# generated-output lock in tools/language_sources.json names each one, so a language added to the
# build plan without an exception here fails the source tests rather than quietly not shipping.
!engine/src/main/assets/lexicon_es.bin
!engine/src/main/assets/bigrams_es.bin
!engine/src/main/assets/trigrams_es.bin

# Local-only benchmark corpus slice (FUTO swipe dataset, 258 MiB upstream). Not redistributable
# from this repo; fetch it and rebuild with tools or the snippet in docs/typing-quality-benchmarks.md.
engine/src/androidTest/assets/swipe_benchmark_subset.jsonl
engine/src/androidTest/assets/swipe_session.jsonl

# Preview rasters and their intermediates: derived from the board geometry on every run, and the
# repo carries the geometry, not the picture. A `git add -A tools` once committed twelve of them.
tools/*.svg
tools/*.html
tools/*-raw.png
tools/send-*.png
tools/look-*.png
tools/*-final.png

# v4 signing byproduct
*.idsig
